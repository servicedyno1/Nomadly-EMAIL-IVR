# White-label build-time brand config for the droplet build (SMADAV).
# On Railway these come from injected env vars (which take precedence over this file),
# so this only supplies them where the shell env doesn't (i.e. the droplet CRA build).
REACT_APP_BRAND_BOT_NAME=SmadavBot
REACT_APP_BRAND_BOT_USERNAME=smadavv_bot
REACT_APP_BRAND_COLOR="#1CA9E0"
REACT_APP_BRAND_FAVICON_URL=https://1.panel.smadavhost.com/smadav-favicon.png
REACT_APP_BRAND_LOGO_URL=https://1.panel.smadavhost.com/smadav-logo.png
REACT_APP_BRAND_NAME=Smadav
REACT_APP_BRAND_PANEL_NAME=SmadavHost
REACT_APP_BRAND_PHONE_NAME=SmadavSpeech
REACT_APP_BRAND_POWERED_BY=Smadav
REACT_APP_BRAND_SUPPORT=@smadavv
REACT_APP_BRAND_TAGLINE="Bot Analytics"
REACT_APP_PANEL_DOMAIN=1.panel.smadavhost.com
REACT_APP_SIP_DOMAIN=sip.smadavspeech.com
